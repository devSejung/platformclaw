#!/usr/bin/env bash

set -euo pipefail

case "$(uname -s 2>/dev/null || true)" in
  MINGW* | MSYS* | CYGWIN*) ;;
  *) exit 0 ;;
esac

repo_root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [[ -z "$repo_root" ]]; then
  exit 0
fi

protected_paths=()
while IFS= read -r -d '' entry; do
  metadata="${entry%%$'\t'*}"
  entry_path="${entry#*$'\t'}"
  mode="${metadata%% *}"
  if [[ "$mode" == "120000" && "/$entry_path/" == *"/node_modules/"* ]]; then
    protected_paths+=("$entry_path")
  fi
done < <(git -C "$repo_root" ls-files --stage -z)

if [[ "${#protected_paths[@]}" -eq 0 ]]; then
  exit 0
fi

if ! git -C "$repo_root" diff --cached --quiet -- "${protected_paths[@]}"; then
  echo "[PlatformClaw] Refusing junction guard update: HEAD/index differ for workspace links." >&2
  exit 1
fi

git -C "$repo_root" update-index --skip-worktree -- "${protected_paths[@]}"
