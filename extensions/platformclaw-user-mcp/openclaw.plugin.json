{
  "id": "platformclaw-user-mcp",
  "name": "PlatformClaw User MCP",
  "description": "Per-user credentials for administrator-approved MCP servers.",
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "servers": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "additionalProperties": false,
          "required": ["auth"],
          "properties": {
            "auth": {
              "type": "string",
              "enum": ["bearer", "api_key", "oauth"]
            },
            "headerName": {
              "type": "string"
            },
            "scope": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
