{
  "id": "platformclaw-user-mcp",
  "name": "PlatformClaw User MCP",
  "description": "Per-user credentials for administrator-approved MCP servers.",
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "servers": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "credentialMode": {
              "type": "string",
              "enum": ["none", "shared", "personal"]
            },
            "headerGuides": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name"],
                "properties": {
                  "name": { "type": "string", "minLength": 1, "maxLength": 128 },
                  "description": { "type": "string", "maxLength": 512 }
                }
              }
            },
            "auth": {
              "type": "string",
              "enum": ["bearer", "api_key", "oauth"]
            },
            "headerName": {
              "type": "string"
            },
            "scope": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
