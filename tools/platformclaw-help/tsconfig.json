{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "jsx": "react-jsx", "strict": true, "noEmit": true,
    "resolveJsonModule": true, "allowSyntheticDefaultImports": true,
    "skipLibCheck": true, "lib": ["ES2022", "DOM"]
  },
  "include": ["src"]
}
