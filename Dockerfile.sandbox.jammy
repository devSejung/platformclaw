# syntax=docker/dockerfile:1.7

ARG PLATFORMCLAW_JAMMY_IMAGE="docker.io/library/ubuntu:22.04@sha256:0e0a0fc6d18feda9db1590da249ac93e8d5abfea8f4c3c0c849ce512b5ef8982"
FROM ${PLATFORMCLAW_JAMMY_IMAGE}

ARG PLATFORMCLAW_URLLIB3_VERSION="2.7.0"
ARG PLATFORMCLAW_MARKDOWN_VERSION="3.10.2"
ARG PLATFORMCLAW_MARKDOWNIFY_VERSION="1.2.3"
ARG PLATFORMCLAW_PYGMENTS_VERSION="2.20.0"
ARG PLATFORMCLAW_REQUESTS_VERSION="2.34.2"
ARG PLATFORMCLAW_NUMPY_VERSION="2.2.6"
ARG PLATFORMCLAW_PYPDF_VERSION="6.16.2"

ENV DEBIAN_FRONTEND=noninteractive \
  LANG=ko_KR.UTF-8 \
  LANGUAGE=ko_KR:ko:en_US:en \
  LC_ALL=ko_KR.UTF-8 \
  TZ=Asia/Seoul

RUN --mount=type=secret,id=platformclaw_apt_sources \
    set -eux; \
    cp /etc/apt/sources.list /tmp/ubuntu.sources.list; \
    if [ -f /run/secrets/platformclaw_apt_sources ]; then \
      cp /run/secrets/platformclaw_apt_sources /etc/apt/sources.list; \
      rm -f /etc/apt/sources.list.d/*.list; \
    fi; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
      bash build-essential ca-certificates curl git jq less libssl-dev locales \
      make pkg-config python-is-python3 python3 python3-pip python3-venv ripgrep unzip vim xz-utils zip; \
    locale-gen ko_KR.UTF-8; \
    ln -snf /usr/share/zoneinfo/Asia/Seoul /etc/localtime; \
    echo Asia/Seoul >/etc/timezone; \
    cp /tmp/ubuntu.sources.list /etc/apt/sources.list; \
    rm -f /tmp/ubuntu.sources.list; \
    rm -rf /var/lib/apt/lists/*; \
    useradd --create-home --shell /bin/bash sandbox

COPY --from=platformclaw-jammy-build /usr/bin/gh /usr/bin/gh

# Build dependencies use public PyPI before the runtime-only company config is
# installed because those indexes may be reachable only from the deployed network.
RUN python3 -m pip install --no-cache-dir \
      "urllib3==${PLATFORMCLAW_URLLIB3_VERSION}" \
      "Markdown==${PLATFORMCLAW_MARKDOWN_VERSION}" \
      "markdownify==${PLATFORMCLAW_MARKDOWNIFY_VERSION}" \
      "Pygments==${PLATFORMCLAW_PYGMENTS_VERSION}" \
      "requests==${PLATFORMCLAW_REQUESTS_VERSION}" \
      "numpy==${PLATFORMCLAW_NUMPY_VERSION}" \
      "pypdf==${PLATFORMCLAW_PYPDF_VERSION}"; \
    python -c 'import markdown, markdownify, numpy, pygments, pypdf, requests, urllib3'

# This file intentionally persists in the internal sandbox image so runtime
# workspace virtualenvs use the approved package indexes. Keep credentials out.
ARG PLATFORMCLAW_PIP_CONFIG_SHA256=""
RUN --mount=type=secret,id=platformclaw_pip_config \
    set -eux; \
    if [ -n "${PLATFORMCLAW_PIP_CONFIG_SHA256}" ]; then \
      test -f /run/secrets/platformclaw_pip_config; \
      printf '%s  %s\n' "${PLATFORMCLAW_PIP_CONFIG_SHA256}" /run/secrets/platformclaw_pip_config | sha256sum -c -; \
      install -m 0644 /run/secrets/platformclaw_pip_config /etc/pip.conf; \
    else \
      test ! -f /run/secrets/platformclaw_pip_config; \
    fi

USER sandbox
WORKDIR /home/sandbox
CMD ["sleep", "infinity"]
