PLATFORMCLAW_IMAGE=platformclaw:<sha12>
PLATFORMCLAW_SANDBOX_IMAGE=platformclaw-sandbox:<sha12>
PLATFORMCLAW_SKILL_HUB_ENABLED=true
PLATFORMCLAW_SKILL_HUB_SERVER_IMAGE=platformclaw-skillhub-server:6e133c006e49
PLATFORMCLAW_SKILL_HUB_SCANNER_IMAGE=platformclaw-skillhub-scanner:6e133c006e49
PLATFORMCLAW_SKILL_HUB_POSTGRES_IMAGE=platformclaw-skillhub-postgres:44c4ee9810ef
PLATFORMCLAW_SKILL_HUB_REDIS_IMAGE=platformclaw-skillhub-redis:e7723ff73d96
PLATFORMCLAW_PUBLIC_ORIGIN=http://127.0.0.1:19002
PLATFORMCLAW_PUBLIC_PORT=19002
PLATFORMCLAW_EMPLOYEE_AUTH_LOGIN_URL=https://<employee-auth-host>/login
PLATFORMCLAW_EMPLOYEE_AUTH_ADSSO_URL=https://<employee-auth-host>/adsso
PLATFORMCLAW_VOC_URL=
PLATFORMCLAW_TZ=Asia/Seoul
PLATFORMCLAW_EMPLOYEE_AUTH_CA_FILE=<deploy-root>/certs/employee-auth-ca.pem
PLATFORMCLAW_KNOX_CDEP_URL=http://<cdep-host>:8080/api/v1/platformclaw/knox/outbound/send
PLATFORMCLAW_SKILL_HUB_URL=http://skillhub.platformclaw.local:8080
PLATFORMCLAW_SKILL_HUB_TOKEN_FILE=/run/secrets/platformclaw_skill_hub_token
PLATFORMCLAW_SKILL_HUB_BOOTSTRAP_PASSWORD_FILE=/run/secrets/platformclaw_skill_hub_bootstrap_password
PLATFORMCLAW_SKILL_HUB_NAMESPACES=global=all
PLATFORMCLAW_SKILL_HUB_MAX_PACKAGE_BYTES=524288000

# Optional public web relay endpoints. Leave blank for normal direct/provider behavior.
WEB_FETCH_RELAY_URL=
WEB_SEARCH_RELAY_URL=

# platformclaw-deploy init replaces <deploy-root> with the service user's home deployment root.
PLATFORMCLAW_GATEWAY_TOKEN_SECRET_FILE=<deploy-root>/secrets/gateway-token
PLATFORMCLAW_GATEWAY_SERVICE_IDENTITY_SECRET_FILE=<deploy-root>/secrets/gateway-service-identity.pem
PLATFORMCLAW_EXECUTION_SERVICE_TOKEN_SECRET_FILE=<deploy-root>/secrets/execution-service-token
PLATFORMCLAW_INITIAL_ADMIN_IDS_SECRET_FILE=<deploy-root>/secrets/initial-admin-ids
PLATFORMCLAW_KNOX_WEBHOOK_SECRET_SECRET_FILE=<deploy-root>/secrets/knox-webhook-secret
PLATFORMCLAW_KNOX_SERVICE_TOKEN_SECRET_FILE=<deploy-root>/secrets/knox-service-token
PLATFORMCLAW_SSH_CREDENTIAL_MASTER_KEY_SECRET_FILE=<deploy-root>/secrets/ssh-credential-master-key
PLATFORMCLAW_EMPLOYEE_AUTH_ADSSO_SECRET_SECRET_FILE=<deploy-root>/secrets/employee-auth-adsso-secret
