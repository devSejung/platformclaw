+    private boolean matchesCurrentAggregate(SkillSearchDocument document) {
+        // Async projections may have been prepared before an edit. Lock the same
+        // namespace before rechecking facts so a delayed writer cannot undo a move.
+        // Explicit FOR UPDATE preserves the row-lock contract across PostgreSQL
+        // and JPA test dialects that emit unsupported SHARE/NO KEY UPDATE variants.
+        platformclawEntityManager.createNativeQuery("select id from namespace where id = :id for update")
+                .setParameter("id", document.namespaceId()).getResultList();
+        var namespace = platformclawEntityManager.find(com.iflytek.skillhub.domain.namespace.Namespace.class,
+                document.namespaceId());
+        var skill = platformclawEntityManager.find(com.iflytek.skillhub.domain.skill.Skill.class, document.skillId());
+        if (namespace == null || skill == null) return false;
+        platformclawEntityManager.refresh(skill);
+        return skill.getNamespaceId().equals(document.namespaceId())
+                && java.util.Objects.equals(namespace.getSlug(), document.namespaceSlug())
+                && java.util.Objects.equals(skill.getDisplayName() != null ? skill.getDisplayName() : skill.getSlug(), document.title())
+                && java.util.Objects.equals(skill.getSummary(), document.summary())
+                && skill.getVisibility().name().equals(document.visibility())
+                && skill.getStatus().name().equals(document.status());
+    }
