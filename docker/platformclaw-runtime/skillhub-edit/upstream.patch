+    // Edit receipts and their search projection must commit atomically. Keep the
+    // existing REQUIRES_NEW entry point for afterCommit/CallerRunsPolicy callers.
+    @Override
+    @Transactional(propagation = Propagation.MANDATORY)
+    public void indexInCurrentTransaction(SkillSearchDocument document) {
+        if (org.springframework.transaction.support.TransactionSynchronizationManager.isActualTransactionActive()
+                && !matchesCurrentAggregate(document)) {
+            org.slf4j.LoggerFactory.getLogger(getClass()).info(
+                    "Skipped stale search projection after aggregate change [skillId={}]", document.skillId());
+            return;
+        }
