+    private Namespace publicationNamespace(String namespaceSlug) {
+        Namespace namespace = namespaceRepository.findBySlug(namespaceSlug)
+                .orElseThrow(() -> new DomainBadRequestException("error.namespace.slug.notFound", namespaceSlug));
+        // Every publication and deletion acquires namespace before aggregate locks.
+        if (TransactionSynchronizationManager.isActualTransactionActive()) {
+            platformclawEntityManager.refresh(namespace, jakarta.persistence.LockModeType.PESSIMISTIC_WRITE);
+        }
+        return namespace;
+    }
