#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
service_user="${PLATFORMCLAW_SERVICE_USER:-platformclaw}"

if [[ "${1:-}" == "--service-user" ]]; then
  if [[ -z "${2:-}" ]]; then
    echo "Usage: platformclaw-compose [--service-user USER] <docker compose arguments...>" >&2
    exit 2
  fi
  service_user="$2"
  shift 2
fi

if (( $# == 0 )); then
  echo "Usage: platformclaw-compose [--service-user USER] <docker compose arguments...>" >&2
  exit 2
fi
if ! getent passwd "$service_user" >/dev/null; then
  echo "PlatformClaw service user does not exist: $service_user" >&2
  exit 1
fi

runtime_uid="$(id -u "$service_user")"
runtime_gid="$(id -g "$service_user")"
service_home="$(getent passwd "$service_user" | cut -d: -f6)"
if [[ "$runtime_uid" == "0" || "$runtime_gid" == "0" ]]; then
  echo "PlatformClaw service user must not be root" >&2
  exit 1
fi
if [[ -z "$service_home" || "$service_home" != /* ]]; then
  echo "PlatformClaw service user has no absolute home directory: $service_user" >&2
  exit 1
fi

export PLATFORMCLAW_RUNTIME_UID="$runtime_uid"
export PLATFORMCLAW_RUNTIME_GID="$runtime_gid"
export PLATFORMCLAW_DEPLOY_ROOT="${PLATFORMCLAW_DEPLOY_ROOT:-$service_home/platformclaw}"
export PLATFORMCLAW_DEPLOY_HOST_ROOT="$PLATFORMCLAW_DEPLOY_ROOT"
export PLATFORMCLAW_ENV_FILE="${PLATFORMCLAW_ENV_FILE:-$PLATFORMCLAW_DEPLOY_ROOT/deployment.env}"
export PLATFORMCLAW_SANDBOX_DOCKER_RUNTIME_DIR="${PLATFORMCLAW_SANDBOX_DOCKER_RUNTIME_DIR:-/run/user/$runtime_uid}"
export PLATFORMCLAW_CREDENTIAL_BROKER_VOLUME_NAME="${PLATFORMCLAW_CREDENTIAL_BROKER_VOLUME_NAME:-platformclaw-credential-broker-$runtime_uid-$runtime_gid}"
export DOCKER_HOST="unix:///var/run/docker.sock"
unset DOCKER_CONTEXT

if [[ "$1" == "environment" ]]; then
  printf 'PLATFORMCLAW_SERVICE_USER=%s\n' "$service_user"
  printf 'PLATFORMCLAW_RUNTIME_UID=%s\n' "$PLATFORMCLAW_RUNTIME_UID"
  printf 'PLATFORMCLAW_RUNTIME_GID=%s\n' "$PLATFORMCLAW_RUNTIME_GID"
  printf 'PLATFORMCLAW_DEPLOY_ROOT=%s\n' "$PLATFORMCLAW_DEPLOY_ROOT"
  printf 'PLATFORMCLAW_DEPLOY_HOST_ROOT=%s\n' "$PLATFORMCLAW_DEPLOY_HOST_ROOT"
  printf 'PLATFORMCLAW_ENV_FILE=%s\n' "$PLATFORMCLAW_ENV_FILE"
  printf 'PLATFORMCLAW_MAIN_DOCKER_HOST=%s\n' "$DOCKER_HOST"
  printf 'PLATFORMCLAW_SANDBOX_DOCKER_RUNTIME_DIR=%s\n' \
    "$PLATFORMCLAW_SANDBOX_DOCKER_RUNTIME_DIR"
  printf 'PLATFORMCLAW_CREDENTIAL_BROKER_VOLUME_NAME=%s\n' \
    "$PLATFORMCLAW_CREDENTIAL_BROKER_VOLUME_NAME"
  exit 0
fi

if [[ ! -f "$PLATFORMCLAW_ENV_FILE" ]]; then
  echo "PlatformClaw deployment environment does not exist: $PLATFORMCLAW_ENV_FILE" >&2
  echo "Run ./platformclaw-deploy init first." >&2
  exit 1
fi

compose_project="${PLATFORMCLAW_COMPOSE_PROJECT:-platformclaw}"
skillhub_enabled="$(sed -n 's/^PLATFORMCLAW_SKILL_HUB_ENABLED=//p' "$PLATFORMCLAW_ENV_FILE" | tail -n 1)"
skillhub_primary_admin_id=""
if [[ "$skillhub_enabled" == "true" ]]; then
  initial_admin_file="$(sed -n 's/^PLATFORMCLAW_INITIAL_ADMIN_IDS_SECRET_FILE=//p' "$PLATFORMCLAW_ENV_FILE" | tail -n 1)"
  if [[ -r "$initial_admin_file" ]]; then
    skillhub_primary_admin_id="$(tr ',' '\n' <"$initial_admin_file" | awk '{$1=$1}; NF { print; exit }')"
  fi
fi
# Stable deployment values come only from deployment.env. Ambient shell values
# must not silently override an image update, rollback, origin, or secret path.
unset PLATFORMCLAW_IMAGE PLATFORMCLAW_SANDBOX_IMAGE \
  PLATFORMCLAW_PUBLIC_ORIGIN PLATFORMCLAW_PUBLIC_PORT \
  PLATFORMCLAW_EMPLOYEE_AUTH_LOGIN_URL PLATFORMCLAW_EMPLOYEE_AUTH_ADSSO_URL PLATFORMCLAW_TZ \
  PLATFORMCLAW_KNOX_CDEP_URL \
  PLATFORMCLAW_EMPLOYEE_AUTH_CA_FILE \
  PLATFORMCLAW_GATEWAY_TOKEN_SECRET_FILE \
  PLATFORMCLAW_GATEWAY_SERVICE_IDENTITY_SECRET_FILE \
  PLATFORMCLAW_EXECUTION_SERVICE_TOKEN_SECRET_FILE \
  PLATFORMCLAW_INITIAL_ADMIN_IDS_SECRET_FILE \
  PLATFORMCLAW_KNOX_WEBHOOK_SECRET_SECRET_FILE \
  PLATFORMCLAW_KNOX_SERVICE_TOKEN_SECRET_FILE \
  PLATFORMCLAW_SSH_CREDENTIAL_MASTER_KEY_SECRET_FILE \
  PLATFORMCLAW_SKILL_HUB_ENABLED PLATFORMCLAW_SKILL_HUB_URL PLATFORMCLAW_SKILL_HUB_TOKEN_FILE \
  PLATFORMCLAW_SKILL_HUB_BOOTSTRAP_PASSWORD_FILE \
  PLATFORMCLAW_SKILL_HUB_PRIMARY_ADMIN_ID \
  PLATFORMCLAW_SKILL_HUB_NAMESPACES PLATFORMCLAW_SKILL_HUB_MAX_PACKAGE_BYTES \
  PLATFORMCLAW_SKILL_HUB_SERVER_IMAGE PLATFORMCLAW_SKILL_HUB_SCANNER_IMAGE \
  PLATFORMCLAW_SKILL_HUB_POSTGRES_IMAGE PLATFORMCLAW_SKILL_HUB_REDIS_IMAGE \
  PLATFORMCLAW_EMPLOYEE_AUTH_ADSSO_SECRET_SECRET_FILE
compose_args=(docker compose --project-name "$compose_project" --env-file "$PLATFORMCLAW_ENV_FILE")
if [[ "$skillhub_enabled" == "true" ]]; then
  export PLATFORMCLAW_SKILL_HUB_PRIMARY_ADMIN_ID="$skillhub_primary_admin_id"
  compose_args+=(--profile skillhub)
fi
exec "${compose_args[@]}" -f "$script_dir/compose.yaml" "$@"
